// Quicky Dating App — Prisma schema
// PostgreSQL-backed (Supabase). Enums are simulated as String with documented allowed values.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  phone         String    @unique
  email         String?   @unique
  name          String?
  age           Int?
  dateOfBirth   DateTime?
  // gender: "male" | "female" | "nonbinary" | "other"
  gender        String?
  // lookingFor: "men" | "women" | "everyone"
  lookingFor    String?
  bio           String?
  city          String?
  lat           Float?
  lng           Float?
  // JSON-encoded array of interest tag strings, e.g. '["hiking","coffee","techno"]'
  interests     String?
  // JSON-encoded array of prompt objects, e.g. '[{"prompt":"My ideal Sunday...","answer":"..."}]'
  prompts       String?
  voiceIntroUrl String?
  isVerified    Boolean   @default(false)
  isPremium     Boolean   @default(false)
  premiumTier   String?
  premiumUntil  DateTime?
  quickyScore   Int       @default(0)
  onboardedAt   DateTime?
  lastActiveAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Discovery preferences (stored inline for fast access)
  discoveryAgeMin       Int?
  discoveryAgeMax       Int?
  discoveryDistanceKm   Int?
  discoveryShowVerifiedOnly Boolean @default(false)
  discoveryRecentlyActive    Boolean @default(false)

  photos           Photo[]
  sentSwipes       Swipe[]  @relation("FromUser")
  receivedSwipes   Swipe[]  @relation("ToUser")
  matchesA         Match[]  @relation("UserA")
  matchesB         Match[]  @relation("UserB")
  sentMessages     Message[]
  messageReactions MessageReaction[] @relation("MessageReactions")
  quickySends      QuickyEvent[] @relation("SenderQuicky")
  quickyReceives   QuickyEvent[] @relation("RecipientQuicky")
  gameSessionsA    GameSession[] @relation("UserA_GS")
  gameSessionsB    GameSession[] @relation("UserB_GS")
  subscriptions    Subscription[]
  reportsFiled     Report[] @relation("Reporter")
  reportsAgainst   Report[] @relation("Reported")
  blockedBy        Block[]  @relation("Blocker")
  blockedUsers     Block[]  @relation("Blocked")
  sessions         Session[]
  settings         UserSettings?
  posts            CommunityPost[] @relation("PostOwner")
  coOwnedPosts     CommunityPost[] @relation("PostCoOwner")
  gamePosts        GamePost[]
  postLikes        PostLike[]      @relation("PostLikes")
  postComments     PostComment[]   @relation("PostComments")
  rolls            Roll[]
  rollLikes        RollLike[]      @relation("RollLikes")
  rollComments     RollComment[]   @relation("RollComments")
  spinRoomMemberships SpinRoomPlayer[]
  spinRoomMessages    SpinRoomMessage[]
  // In-game economy
  coinBalance         Int              @default(500) // start with 500 coins
  // Kiss Points — earned when another round participant chooses ❤️ for you
  // (kept in sync with KissPointTransaction rows, PRD §5/§6)
  kissPoints          Int              @default(0)
  gamesPlayed         Int              @default(0)
  kissesGiven         Int              @default(0)
  giftsSentCount      Int              @default(0)
  giftsReceivedCount  Int              @default(0)
  sentGifts           SpinRoomGift[]   @relation("GiftSender")
  receivedGifts       SpinRoomGift[]   @relation("GiftRecipient")
  coinLedger          CoinLedger[]
  userItems           UserItem[]
  equippedFrameId     String?          // FK to ProfileFrame.id (denormalized for speed)
  userFrames          UserFrame[]
  // Admin panel access (gift catalog management, v3 PRD §62) — seeded per
  // phone; never exposed as an editable client toggle.
  isAdmin             Boolean          @default(false)
  // ─── Game Chat (private player-to-player, game-chat PRD §7/§114) ─────────
  gameConversationsA  GameConversation[] @relation("GameConvA")
  gameConversationsB  GameConversation[] @relation("GameConvB")
  gameConvMembers     GameConversationMember[]
  gameMessages        GameMessage[]
  gameMessageReactions GameMessageReaction[]
  ownedStickerBundles UserGameStickerBundle[]
  // Bug-fix PRD §77: per-user Quicky streak (Quicky Images in Game Chat).
  gameQuickyStreak    GameQuickyStreak?
}

model Photo {
  id        String   @id @default(cuid())
  userId    String
  url       String
  position  Int      @default(0)
  isPrimary Boolean  @default(false)
  isPrivate Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Swipe {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  // type: "like" | "superlike" | "pass"
  type       String
  // Set when the recipient opened the liker's profile FROM the Likes page —
  // drives the incoming-likes badge (cleared one-by-one only on that path)
  viewedAt   DateTime?
  createdAt  DateTime @default(now())
  fromUser   User @relation("FromUser", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     User @relation("ToUser", fields: [toUserId], references: [id], onDelete: Cascade)
  @@unique([fromUserId, toUserId])
}

model Match {
  id            String    @id @default(cuid())
  userAId       String
  userBId       String
  // status: "active" | "unmatched" | "archived"
  status        String    @default("active")
  createdAt     DateTime  @default(now())
  lastMessageAt DateTime?
  userA         User       @relation("UserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB         User       @relation("UserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages      Message[]
  gameSessions  GameSession[]
}

model Message {
  id                 String    @id @default(cuid())
  matchId            String
  senderId           String
  // type: "text" | "image" | "video" | "quicky" | "system"
  type               String
  text               String?
  mediaUrl           String?
  quickyDuration     Int?
  quickyOpenedAt     DateTime?
  // Set when the Quicky has been viewed — media file is permanently deleted
  quickyConsumedAt   DateTime?
  quickyExpiresAt    DateTime?
  // Duration of a voice message in milliseconds
  mediaDuration      Int?
  screenshotFlagged  Boolean   @default(false)
  // Set when the recipient's device has the message (delivery tick)
  deliveredAt        DateTime?
  // Set when the recipient has read the message (read receipts)
  readAt             DateTime?
  // Reply / quote threading
  replyToId          String?
  replyTo            Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies            Message[] @relation("MessageReplies")
  createdAt          DateTime  @default(now())
  match              Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender             User  @relation(fields: [senderId], references: [id], onDelete: Cascade)
  reactions          MessageReaction[]

  // Indexes for common query patterns
  @@index([matchId, createdAt])                          // list messages in a match
  @@index([matchId, senderId, readAt])                   // count unread per match
  @@index([matchId, type, quickyConsumedAt, quickyExpiresAt]) // sweep expired quickies
}

// One reaction per user per message — latest wins (WhatsApp-style)
model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User    @relation("MessageReactions", fields: [userId], references: [id], onDelete: Cascade)
  @@unique([messageId, userId])
}

model QuickyEvent {
  id          String   @id @default(cuid())
  senderId    String
  recipientId String
  messageId   String?
  // eventType: "sent" | "opened" | "replay" | "screenshot" | "streak_milestone"
  eventType   String
  pointsAwarded Int?
  createdAt   DateTime @default(now())
  sender      User @relation("SenderQuicky", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User @relation("RecipientQuicky", fields: [recipientId], references: [id], onDelete: Cascade)
}

model GameSession {
  id             String    @id @default(cuid())
  matchId        String
  userAId        String
  userBId        String
  // gameType: "truth_or_dare" | "never_have_i_ever" | "would_you_rather" | "icebreaker_roulette" | "two_truths_lie"
  gameType       String
  // status: "active" | "ended"
  status         String    @default("active")
  currentTurn     Int       @default(0)
  currentPlayerId String?
  // JSON game state blob (e.g. Ludo board) — authoritative server-side copy
  state           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  match          Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  posts          GamePost[]

  @@index([matchId, status])
  userA          User       @relation("UserA_GS", fields: [userAId], references: [id], onDelete: Cascade)
  userB          User       @relation("UserB_GS", fields: [userBId], references: [id], onDelete: Cascade)
  turns          GameTurn[]
}

model GameTurn {
  id             String   @id @default(cuid())
  sessionId      String
  playerId       String
  // deck: "flirty" | "deep" | "funny" | "spicy"
  promptDeck     String?
  promptText     String
  // choice: "truth" | "dare" | "yes" | "no" | "option_a" | "option_b"
  choice         String?
  answerText     String?
  answerMediaUrl  String?
  skipped        Boolean  @default(false)
  createdAt      DateTime @default(now())
  session        GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Subscription {
  id         String   @id @default(cuid())
  userId     String
  // plan: "weekly" | "monthly" | "quarterly" | "annual"
  plan       String
  // status: "active" | "cancelled" | "expired"
  status     String   @default("active")
  startedAt  DateTime @default(now())
  expiresAt  DateTime
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Report {
  id            String   @id @default(cuid())
  reporterId    String
  reportedId    String
  // category: "harassment" | "spam" | "fake" | "inappropriate" | "underage" | "other"
  category      String
  details       String?
  screenshotUrl String?
  // status: "pending" | "reviewing" | "resolved"
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  reporter      User @relation("Reporter", fields: [reporterId], references: [id])
  reported      User @relation("Reported", fields: [reportedId], references: [id])
}

model Block {
  id         String   @id @default(cuid())
  blockerId  String
  blockedId  String
  createdAt  DateTime @default(now())
  blocker    User @relation("Blocker", fields: [blockerId], references: [id])
  blocked    User @relation("Blocked", fields: [blockedId], references: [id])
  @@unique([blockerId, blockedId])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OtpCode {
  id         String   @id @default(cuid())
  phone      String
  code       String
  expiresAt  DateTime
  consumed   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model EmailOtpCode {
  id         String   @id @default(cuid())
  email      String
  code       String
  expiresAt  DateTime
  consumed   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model UserSettings {
  id                   String   @id @default(cuid())
  userId               String   @unique
  // Notification toggles
  notifMessages        Boolean  @default(true)
  notifConnectionReqs  Boolean  @default(true)
  notifLikes           Boolean  @default(true)
  notifProfileViews    Boolean  @default(true)
  notifSnackbars       Boolean  @default(true)
  // Privacy toggles
  privacyHideAge       Boolean  @default(false)
  privacyHideDistance   Boolean  @default(false)
  privacyHideOnline     Boolean  @default(false) // premium
  privacyHideTyping     Boolean  @default(false) // premium
  privacyHideReadReceipts Boolean @default(false) // premium
  // Theme: dark | midnight | coral | lavender | gold
  theme                String   @default("dark")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Community ────────────────────────────────────────────────────────────────

// Instagram-style feed post. 'filter' stores the id of the client-side filter
// preset (src/lib/quicky/filters.ts) so every viewer sees the same look.
model CommunityPost {
  id        String   @id @default(cuid())
  userId    String
  // Mutual game posts have two owners — both players' ids are shown
  coOwnerId String?
  caption   String?
  // Game-result posts render as a catchy text template card (no media)
  mediaUrl  String?
  // mediaType: "image" | "video"
  mediaType String   @default("image")
  filter    String?
  // gameType: "truth_or_dare" | "never_have_i_ever" | "ludo" (null = normal post)
  gameType      String?
  gameTitle     String?
  gameBody      String?
  emoji         String?
  gameSessionId String?
  // Owners can disable comments per post (default true; both UI and API enforce)
  commentsEnabled Boolean @default(true)
  createdAt DateTime @default(now())
  user      User          @relation("PostOwner", fields: [userId], references: [id], onDelete: Cascade)
  coOwner   User?         @relation("PostCoOwner", fields: [coOwnerId], references: [id], onDelete: SetNull)
  likes     PostLike[]
  comments  PostComment[]

  @@index([createdAt])
  @@index([userId])
  @@index([coOwnerId])
}

// A shareable game-result post generated for BOTH players when a game
// session ends. Each player can publish their copy to the Community; when
// both publish, the two CommunityPosts become mutual (coOwnerId set).
model GamePost {
  id        String   @id @default(cuid())
  sessionId String
  userId    String
  matchId   String
  gameType  String
  title     String
  body      String
  emoji     String   @default("🎮")
  // shared → the user published their copy to the Community feed
  shared    Boolean  @default(false)
  postId    String?
  createdAt DateTime @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  session   GameSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@index([userId, shared])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation("PostLikes", fields: [userId], references: [id], onDelete: Cascade)
  @@unique([postId, userId])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  text      String
  createdAt DateTime @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation("PostComments", fields: [userId], references: [id], onDelete: Cascade)
}

// Stories, called "Rolls" in Quicky — ephemeral 24h media.
// Liking/commenting is gated server-side to premium users or mutual matches.
model Roll {
  id        String   @id @default(cuid())
  userId    String
  caption   String?
  mediaUrl  String
  // mediaType: "image" | "video"
  mediaType String   @default("image")
  filter    String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes     RollLike[]
  comments  RollComment[]
}

model RollLike {
  id        String   @id @default(cuid())
  rollId    String
  userId    String
  createdAt DateTime @default(now())
  roll      Roll @relation(fields: [rollId], references: [id], onDelete: Cascade)
  user      User @relation("RollLikes", fields: [userId], references: [id], onDelete: Cascade)
  @@unique([rollId, userId])
}

model RollComment {
  id        String   @id @default(cuid())
  rollId    String
  userId    String
  text      String
  createdAt DateTime @default(now())
  roll      Roll @relation(fields: [rollId], references: [id], onDelete: Cascade)
  user      User @relation("RollComments", fields: [userId], references: [id], onDelete: Cascade)
}

// ── Spin the Bottle (multiplayer community game) ────────────────────────────
// V1: up to 12 players per room, server-authoritative spin + kiss flow.
// Drives: SPINNING → AWAITING → RESULT → NEXT_TURN via Node setTimeout.
model SpinRoom {
  id              String   @id @default(cuid())
  status          String   @default("WAITING") // WAITING | STARTING | PLAYING | CLOSING
  maxPlayers      Int      @default(12)
  minPlayers      Int      @default(2)
  currentTurnIdx  Int      @default(0)
  // ID of the active spin row (kept here for fast polling lookup)
  currentSpinId   String?
  startedAt       DateTime?
  singletonStartedAt DateTime?
  lastActivityAt  DateTime @default(now())
  createdAt       DateTime @default(now())
  players         SpinRoomPlayer[]
  spins           SpinBottleSpin[]
  messages        SpinRoomMessage[]
  gifts           SpinRoomGift[]

  @@index([status, lastActivityAt])
}

model SpinRoomPlayer {
  id            String   @id @default(cuid())
  roomId        String
  userId        String
  // 0..11 fixed seat around the table (assigned on join)
  seatIndex     Int
  // 0..N-1 order in the current turn rotation
  turnIndex     Int
  // "online" | "reconnecting" | "offline"
  connection    String   @default("online")
  joinedAt      DateTime @default(now())
  leftAt        DateTime?
  lastActivityAt DateTime @default(now())
  isActive      Boolean  @default(true)
  room          SpinRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId, leftAt])
  @@index([roomId, isActive, turnIndex])
  @@index([roomId, isActive, lastActivityAt])
}

model SpinBottleSpin {
  id              String   @id @default(cuid())
  roomId          String
  turnIndex       Int
  spinnerId       String
  // Server-chosen opposite-gender target (null only between server restart + first advance)
  targetId        String?
  // Bottle's rotational start + end, in radians
  startRotation   Float
  endRotation     Float
  duration        Int      @default(3500)
  // "spinning" | "awaiting" | "completed"
  status          String   @default("spinning")
  // Legacy single-answer field (target-only V1 rounds). Kept so old rows and
  // any forgotten reader still resolve; new rounds leave it null.
  response        String?
  // Two-party round responses ("yes" | "no" | "timeout") — BOTH the spinner
  // and the target answer independently (PRD §4/§5/§28).
  spinnerResponse String?
  targetResponse  String?
  // "mutual_kiss" | "partial_kiss" | "full_rejection" — computed SERVER-SIDE
  // when both responses are in (PRD §5/§31).
  result          String?
  // Server timestamp: responseDeadline = landedAt + 10s. Clients derive the
  // visible countdown from this + serverNow (PRD §29) — never from a local
  // setInterval seeded at 10.
  responseDeadline DateTime?
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  room            SpinRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  events          SpinBottleEvent[]
  kissPoints      KissPointTransaction[]

  @@index([roomId, turnIndex])
  @@index([roomId, status])
}

// Ledger of every Kiss Point awarded inside a round (PRD §6). A user earns a
// point whenever ANOTHER participant chooses ❤️ for them — mutual = +1 each,
// partial = +1 for the kissed party, full rejection = 0. Rows (not bare
// counters) make duplicate rewards structurally impossible.
model KissPointTransaction {
  id          String   @id @default(cuid())
  roundId     String
  // Who chose ❤️ for the recipient (null = system adjustment)
  fromUserId  String?
  toUserId    String
  points      Int
  // "round_kiss"
  reason      String
  createdAt   DateTime @default(now())
  spin        SpinBottleSpin @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([roundId])
  @@index([toUserId, createdAt])
}

model SpinBottleEvent {
  id         String   @id @default(cuid())
  spinId     String
  // "kiss_yes" | "kiss_no" | "kiss_timeout" | "system"
  kind       String
  fromUserId String?
  toUserId   String?
  meta       String?
  createdAt  DateTime @default(now())
  spin       SpinBottleSpin @relation(fields: [spinId], references: [id], onDelete: Cascade)

  @@index([spinId, createdAt])
}

model SpinRoomMessage {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  text      String
  // "user" | "system" | "gift" (system messages also pin a userId — usually the spinner)
  kind      String   @default("user")
  // JSON metadata — used by gift messages to carry { itemId, itemName, itemEmoji, recipientId, recipientName }
  metadata  String?
  createdAt DateTime @default(now())
  room      SpinRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
}

// ── In-game economy ───────────────────────────────────────────────────────────

// Gift catalog categories (v3 PRD §49) — admin-manageable grouping for the
// gift catalog. Seed rows: Popular, Romantic, Cute, Funny, Premium, Special.
model GiftCategory {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  icon      String   @default("🎁")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  gifts     GameItem[]
}

// Catalog of purchasable/sendable gift items
model GameItem {
  id          String   @id @default(cuid())
  // "gift" | "frame" | "bottle_skin" | "table_skin"
  category    String   @default("gift")
  // Stable seed/admin identifier (bug-fix PRD §127) — e.g. "gift_rose".
  // Nullable: admin-created rows may omit it. Unique for idempotent seeding.
  slug        String?  @unique
  // Gift catalog category (v3 PRD §50) — FK into GiftCategory
  categoryId  String?
  giftCategory GiftCategory? @relation(fields: [categoryId], references: [id])
  name        String
  emoji       String
  // Future-proof icon storage (v3 PRD §67): "emoji" today, "image" (URL in
  // iconValue) when admins can upload custom gift artwork.
  iconType    String   @default("emoji")
  iconValue   String?
  description String?
  coinPrice   Int      // cost in coins
  // For frames: the CSS/asset class name or URL
  assetKey    String?
  // "default" | "premium" | "seasonal"
  tier        String   @default("default")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userItems   UserItem[]
  gifts       SpinRoomGift[]
  frames      ProfileFrame[]

  @@index([categoryId, isActive, sortOrder])
}

// User's owned items
model UserItem {
  id         String   @id @default(cuid())
  userId     String
  itemId     String
  quantity   Int      @default(1)
  acquiredAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item       GameItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  @@unique([userId, itemId])
  @@index([userId])
}

// Audit log for coin balance changes
model CoinLedger {
  id        String   @id @default(cuid())
  userId    String
  delta     Int      // positive = earned, negative = spent
  reason    String   // "gift_sent" | "gift_received" | "kiss_yes" | "purchase" | "starting_bonus"
  meta      String?  // JSON with context (e.g. itemId, roomId)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

// In-room gift transaction (one row per gift send)
model SpinRoomGift {
  id          String   @id @default(cuid())
  roomId      String
  senderId    String
  recipientId String
  itemId      String
  quantity    Int      @default(1)
  coinsSpent  Int
  createdAt   DateTime @default(now())
  room        SpinRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender      User     @relation("GiftSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User     @relation("GiftRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  item        GameItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  @@index([roomId, createdAt])
  @@index([senderId])
  @@index([recipientId])
}

// Collectible profile frames (visual ring around player avatar)
model ProfileFrame {
  id          String     @id @default(cuid())
  itemId      String     // link back to GameItem catalog
  name        String
  // "static" | "animated" | "seasonal"
  frameType   String     @default("static")
  // CSS class or animation keyframe key
  cssClass    String
  // Preview image/gif URL
  previewUrl  String?
  createdAt   DateTime   @default(now())
  item        GameItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userFrames  UserFrame[]
  @@index([itemId])
}

// Which users own which frames + which is equipped
model UserFrame {
  id        String       @id @default(cuid())
  userId    String
  frameId   String
  equipped  Boolean      @default(false)
  acquiredAt DateTime    @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  frame     ProfileFrame @relation(fields: [frameId], references: [id], onDelete: Cascade)
  @@unique([userId, frameId])
  @@index([userId, equipped])
}

// "How It Works" rules (admin managed, lifecycle PRD §44/§48/§49)
model GameRule {
  id          String   @id @default(cuid())
  gameType    String   @default("spin_the_bottle")
  title       String
  description String
  icon        String   @default("🎲")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([gameType, isActive, sortOrder])
}

// Record WHY a user's room vanished — survives the room itself (§28/§29)
model SpinRoomClosure {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  // "singleton" | "inactivity" | "closed"
  reason    String
  createdAt DateTime @default(now())

  @@index([roomId, userId, createdAt])
  @@index([createdAt])
}


// ═══ GAME CHAT — private player-to-player messaging (game-chat PRD §11-§16) ═══
// Deliberately SEPARATE from the Dating Chat (Match/Message) system and from
// the temporary room chat (SpinRoomMessage): conversations are a persistent
// relationship between two USERS, never tied to a room id (§59/§60/§61).
// Canonical pair ordering (userAId < userBId) makes conversation(userA,userB)
// resolve to EXACTLY one row (§11 — no duplicate A→B conversations).
model GameConversation {
  id            String    @id @default(cuid())
  userAId       String
  userBId       String
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  userA    User @relation("GameConvA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User @relation("GameConvB", fields: [userBId], references: [id], onDelete: Cascade)
  members  GameConversationMember[]
  messages GameMessage[]

  @@unique([userAId, userBId])
  @@index([userAId, lastMessageAt])
  @@index([userBId, lastMessageAt])
}

// Read-receipt model (§15): per-member lastReadAt — unread = messages with
// createdAt > lastReadAt AND senderId != me. Simple + efficient for 1-to-1.
model GameConversationMember {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime @default(now())

  conversation GameConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, lastReadAt])
}

// game_messages (§13): message_type text | sticker | image | voice |
// quicky_image (bug-fix PRD §81 — strongly typed set, future types addable).
// clientMessageId gives optimistic sends a deterministic id for safe
// de-duplication (§92/§93) — unique per (conversation, sender).
// Media messages store a storage REFERENCE (media_url), never binaries
// (bug-fix PRD §58/§117): the upload endpoint is the only source of URLs.
model GameMessage {
  id               String    @id @default(cuid())
  conversationId   String
  senderId         String
  messageType      String    @default("text") // text | sticker | image | voice | quicky_image
  text             String?
  stickerId        String?
  mediaUrl         String?
  // Voice note duration in milliseconds (bug-fix PRD §65).
  mediaDuration    Int?
  replyToMessageId String?
  clientMessageId  String?
  createdAt        DateTime  @default(now())
  editedAt         DateTime?
  deletedAt        DateTime?

  conversation GameConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User             @relation(fields: [senderId], references: [id], onDelete: Cascade)
  sticker      GameSticker?     @relation(fields: [stickerId], references: [id], onDelete: SetNull)
  reactions    GameMessageReaction[]

  @@index([conversationId, createdAt])
  @@unique([conversationId, senderId, clientMessageId])
}

// One active reaction per user per message (§31).
model GameMessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  reaction  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  message GameMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
}

// ─── QUICKY STREAK (bug-fix PRD §75-§79) ─────────────────────────────────────
// Per-user streak for qualifying Quicky interactions sent through Game Chat.
// The Dating-Chat per-match streak is a DIFFERENT product surface — this one
// is per USER and follows the same consecutive-calendar-day rule computed
// with SERVER time (§76/§78). One qualifying event updates it exactly once
// (same transaction as the message insert + points award, §79).
model GameQuickyStreak {
  id                 String   @id @default(cuid())
  userId             String   @unique
  currentStreak      Int      @default(0)
  longestStreak      Int      @default(0)
  // UTC calendar date (YYYY-MM-DD) of the last qualifying interaction.
  lastQualifyingDate String?
  totalQuickyImages  Int      @default(0)
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ═══ GAME STICKERS — admin-managed bundles (game-chat PRD §62-§77) ══════════
// Architecture NOW, purchasing/rewards later (§76/§77): bundles belong to an
// optional league and/or season (never hardcoded in the frontend, §65), are
// acquired by coin purchase and/or league reward, and users OWN bundles via
// UserGameStickerBundle before they may send a sticker (§68/§75).
model GameLeague {
  id            String   @id @default(cuid())
  name          String
  minimumPoints Int      @default(0)
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bundles GameStickerBundle[]
}

model GameSeason {
  id        String    @id @default(cuid())
  name      String
  startsAt  DateTime?
  endsAt    DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  bundles GameStickerBundle[]
}

model GameStickerBundle {
  id                  String   @id @default(cuid())
  name                String
  description         String?
  icon                String   @default("✨")
  leagueId            String?
  seasonId            String?
  priceCoins          Int      @default(0)
  minimumLeaguePoints Int      @default(0)
  purchaseEnabled     Boolean  @default(true)
  rewardEnabled       Boolean  @default(false)
  isActive            Boolean  @default(true)
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  league   GameLeague?  @relation(fields: [leagueId], references: [id], onDelete: SetNull)
  season   GameSeason?  @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  stickers GameSticker[]
  owners   UserGameStickerBundle[]

  @@index([isActive, sortOrder])
}

// Sticker assets are REFERENCES (asset_url), never binaries in the row (§73).
model GameSticker {
  id        String   @id @default(cuid())
  bundleId  String
  name      String
  assetUrl  String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bundle   GameStickerBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  messages GameMessage[]

  @@index([bundleId, sortOrder])
}

// Ownership (§68): source = purchase | league_reward | admin_grant.
model UserGameStickerBundle {
  id         String   @id @default(cuid())
  userId     String
  bundleId   String
  source     String
  acquiredAt DateTime @default(now())

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  bundle GameStickerBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@unique([userId, bundleId])
  @@index([userId])
}

// ═══ ADMIN AUDIT (game-chat PRD §120) ═══════════════════════════════════════
// Who changed what important configuration, and when. No FK — the audit
// trail must survive the admin account being deleted.
model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  entityType String
  entityId   String
  meta       String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([adminId, createdAt])
}