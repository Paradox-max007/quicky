// Quicky Dating App — Prisma schema
// PostgreSQL-backed (Supabase). Enums are simulated as String with documented allowed values.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  phone         String    @unique
  email         String?   @unique
  name          String?
  age           Int?
  dateOfBirth   DateTime?
  // gender: "male" | "female" | "nonbinary" | "other"
  gender        String?
  // lookingFor: "men" | "women" | "everyone"
  lookingFor    String?
  bio           String?
  city          String?
  lat           Float?
  lng           Float?
  // JSON-encoded array of interest tag strings, e.g. '["hiking","coffee","techno"]'
  interests     String?
  // JSON-encoded array of prompt objects, e.g. '[{"prompt":"My ideal Sunday...","answer":"..."}]'
  prompts       String?
  voiceIntroUrl String?
  isVerified    Boolean   @default(false)
  isPremium     Boolean   @default(false)
  premiumTier   String?
  premiumUntil  DateTime?
  quickyScore   Int       @default(0)
  onboardedAt   DateTime?
  lastActiveAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Discovery preferences (stored inline for fast access)
  discoveryAgeMin       Int?
  discoveryAgeMax       Int?
  discoveryDistanceKm   Int?
  discoveryShowVerifiedOnly Boolean @default(false)
  discoveryRecentlyActive    Boolean @default(false)

  photos           Photo[]
  sentSwipes       Swipe[]  @relation("FromUser")
  receivedSwipes   Swipe[]  @relation("ToUser")
  matchesA         Match[]  @relation("UserA")
  matchesB         Match[]  @relation("UserB")
  sentMessages     Message[]
  messageReactions MessageReaction[] @relation("MessageReactions")
  quickySends      QuickyEvent[] @relation("SenderQuicky")
  quickyReceives   QuickyEvent[] @relation("RecipientQuicky")
  gameSessionsA    GameSession[] @relation("UserA_GS")
  gameSessionsB    GameSession[] @relation("UserB_GS")
  subscriptions    Subscription[]
  reportsFiled     Report[] @relation("Reporter")
  reportsAgainst   Report[] @relation("Reported")
  blockedBy        Block[]  @relation("Blocker")
  blockedUsers     Block[]  @relation("Blocked")
  sessions         Session[]
  settings         UserSettings?
  posts            CommunityPost[]
  postLikes        PostLike[]      @relation("PostLikes")
  postComments     PostComment[]   @relation("PostComments")
  rolls            Roll[]
  rollLikes        RollLike[]      @relation("RollLikes")
  rollComments     RollComment[]   @relation("RollComments")
}

model Photo {
  id        String   @id @default(cuid())
  userId    String
  url       String
  position  Int      @default(0)
  isPrimary Boolean  @default(false)
  isPrivate Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Swipe {
  id         String   @id @default(cuid())
  fromUserId String
  toUserId   String
  // type: "like" | "superlike" | "pass"
  type       String
  createdAt  DateTime @default(now())
  fromUser   User @relation("FromUser", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     User @relation("ToUser", fields: [toUserId], references: [id], onDelete: Cascade)
  @@unique([fromUserId, toUserId])
}

model Match {
  id            String    @id @default(cuid())
  userAId       String
  userBId       String
  // status: "active" | "unmatched" | "archived"
  status        String    @default("active")
  createdAt     DateTime  @default(now())
  lastMessageAt DateTime?
  userA         User       @relation("UserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB         User       @relation("UserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages      Message[]
  gameSessions  GameSession[]
}

model Message {
  id                 String    @id @default(cuid())
  matchId            String
  senderId           String
  // type: "text" | "image" | "video" | "quicky" | "system"
  type               String
  text               String?
  mediaUrl           String?
  quickyDuration     Int?
  quickyOpenedAt     DateTime?
  // Set when the Quicky has been viewed — media file is permanently deleted
  quickyConsumedAt   DateTime?
  quickyExpiresAt    DateTime?
  screenshotFlagged  Boolean   @default(false)
  // Set when the recipient's device has the message (delivery tick)
  deliveredAt        DateTime?
  // Set when the recipient has read the message (read receipts)
  readAt             DateTime?
  // Reply / quote threading
  replyToId          String?
  replyTo            Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies            Message[] @relation("MessageReplies")
  createdAt          DateTime  @default(now())
  match              Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  sender             User  @relation(fields: [senderId], references: [id], onDelete: Cascade)
  reactions          MessageReaction[]

  // Indexes for common query patterns
  @@index([matchId, createdAt])                          // list messages in a match
  @@index([matchId, senderId, readAt])                   // count unread per match
  @@index([matchId, type, quickyConsumedAt, quickyExpiresAt]) // sweep expired quickies
}

// One reaction per user per message — latest wins (WhatsApp-style)
model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User    @relation("MessageReactions", fields: [userId], references: [id], onDelete: Cascade)
  @@unique([messageId, userId])
}

model QuickyEvent {
  id          String   @id @default(cuid())
  senderId    String
  recipientId String
  messageId   String?
  // eventType: "sent" | "opened" | "replay" | "screenshot" | "streak_milestone"
  eventType   String
  pointsAwarded Int?
  createdAt   DateTime @default(now())
  sender      User @relation("SenderQuicky", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User @relation("RecipientQuicky", fields: [recipientId], references: [id], onDelete: Cascade)
}

model GameSession {
  id             String    @id @default(cuid())
  matchId        String
  userAId        String
  userBId        String
  // gameType: "truth_or_dare" | "never_have_i_ever" | "would_you_rather" | "icebreaker_roulette" | "two_truths_lie"
  gameType       String
  // status: "active" | "ended"
  status         String    @default("active")
  currentTurn     Int       @default(0)
  currentPlayerId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  match          Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userA          User       @relation("UserA_GS", fields: [userAId], references: [id], onDelete: Cascade)
  userB          User       @relation("UserB_GS", fields: [userBId], references: [id], onDelete: Cascade)
  turns          GameTurn[]
}

model GameTurn {
  id             String   @id @default(cuid())
  sessionId      String
  playerId       String
  // deck: "flirty" | "deep" | "funny" | "spicy"
  promptDeck     String?
  promptText     String
  // choice: "truth" | "dare" | "yes" | "no" | "option_a" | "option_b"
  choice         String?
  answerText     String?
  answerMediaUrl  String?
  skipped        Boolean  @default(false)
  createdAt      DateTime @default(now())
  session        GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Subscription {
  id         String   @id @default(cuid())
  userId     String
  // plan: "weekly" | "monthly" | "quarterly" | "annual"
  plan       String
  // status: "active" | "cancelled" | "expired"
  status     String   @default("active")
  startedAt  DateTime @default(now())
  expiresAt  DateTime
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Report {
  id            String   @id @default(cuid())
  reporterId    String
  reportedId    String
  // category: "harassment" | "spam" | "fake" | "inappropriate" | "underage" | "other"
  category      String
  details       String?
  screenshotUrl String?
  // status: "pending" | "reviewing" | "resolved"
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  reporter      User @relation("Reporter", fields: [reporterId], references: [id])
  reported      User @relation("Reported", fields: [reportedId], references: [id])
}

model Block {
  id         String   @id @default(cuid())
  blockerId  String
  blockedId  String
  createdAt  DateTime @default(now())
  blocker    User @relation("Blocker", fields: [blockerId], references: [id])
  blocked    User @relation("Blocked", fields: [blockedId], references: [id])
  @@unique([blockerId, blockedId])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OtpCode {
  id         String   @id @default(cuid())
  phone      String
  code       String
  expiresAt  DateTime
  consumed   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model EmailOtpCode {
  id         String   @id @default(cuid())
  email      String
  code       String
  expiresAt  DateTime
  consumed   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model UserSettings {
  id                   String   @id @default(cuid())
  userId               String   @unique
  // Notification toggles
  notifMessages        Boolean  @default(true)
  notifConnectionReqs  Boolean  @default(true)
  notifLikes           Boolean  @default(true)
  notifProfileViews    Boolean  @default(true)
  notifSnackbars       Boolean  @default(true)
  // Privacy toggles
  privacyHideAge       Boolean  @default(false)
  privacyHideDistance   Boolean  @default(false)
  privacyHideOnline     Boolean  @default(false) // premium
  privacyHideTyping     Boolean  @default(false) // premium
  privacyHideReadReceipts Boolean @default(false) // premium
  // Theme: dark | midnight | coral | lavender | gold
  theme                String   @default("dark")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Community ────────────────────────────────────────────────────────────────

// Instagram-style feed post. 'filter' stores the id of the client-side filter
// preset (src/lib/quicky/filters.ts) so every viewer sees the same look.
model CommunityPost {
  id        String   @id @default(cuid())
  userId    String
  caption   String?
  mediaUrl  String
  // mediaType: "image" | "video"
  mediaType String   @default("image")
  filter    String?
  createdAt DateTime @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes     PostLike[]
  comments  PostComment[]
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation("PostLikes", fields: [userId], references: [id], onDelete: Cascade)
  @@unique([postId, userId])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  text      String
  createdAt DateTime @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation("PostComments", fields: [userId], references: [id], onDelete: Cascade)
}

// Stories, called "Rolls" in Quicky — ephemeral 24h media.
// Liking/commenting is gated server-side to premium users or mutual matches.
model Roll {
  id        String   @id @default(cuid())
  userId    String
  caption   String?
  mediaUrl  String
  // mediaType: "image" | "video"
  mediaType String   @default("image")
  filter    String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes     RollLike[]
  comments  RollComment[]
}

model RollLike {
  id        String   @id @default(cuid())
  rollId    String
  userId    String
  createdAt DateTime @default(now())
  roll      Roll @relation(fields: [rollId], references: [id], onDelete: Cascade)
  user      User @relation("RollLikes", fields: [userId], references: [id], onDelete: Cascade)
  @@unique([rollId, userId])
}

model RollComment {
  id        String   @id @default(cuid())
  rollId    String
  userId    String
  text      String
  createdAt DateTime @default(now())
  roll      Roll @relation(fields: [rollId], references: [id], onDelete: Cascade)
  user      User @relation("RollComments", fields: [userId], references: [id], onDelete: Cascade)
}
